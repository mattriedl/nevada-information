// Cloudflare Workers config for nevadainformation.com (deployed by Workers Builds on every push to main).
// The site itself is the static build in public/ (python3 build/generate_site.py); worker/index.js only
// sends www and http traffic to https://nevadainformation.com and keeps the workers.dev preview out of search.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nevada-information",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "nevadainformation.com", "custom_domain": true },
    { "pattern": "www.nevadainformation.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
